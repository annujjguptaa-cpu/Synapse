# Synapse OS Environment Variables

# Frontend Supabase Config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend Supabase Config (Optional event persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key_here

# Backend Server Configuration
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & API Keys
# Comma-separated list of keys, either bare 'api_key' or 'projectId:api_key'
SYNAPSE_API_KEYS=synapse-test-key,default:demo-agent-key

# Verifier Token (replaces hardcoded demo token)
SYNAPSE_VERIFIER_TOKEN=synapse-verifier-secret-token

# Dashboard Operator Access Token (used for dashboard actions / Socket.IO)
DASHBOARD_AUTH_TOKEN=synapse-dashboard-admin-token

# AI scenario generation (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
